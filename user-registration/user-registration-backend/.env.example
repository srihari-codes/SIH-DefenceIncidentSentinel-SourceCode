# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/defence_sentinel

# JWT Secrets (generate secure 256-bit secrets for production)
JWT_SECRET=your-256-bit-secret-for-challenge-tokens-replace-in-production
JWT_REFRESH_SECRET=your-256-bit-secret-for-refresh-tokens-replace-in-production

# Encryption Key (32-byte hex key for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@defence.gov.in
SMTP_PASSWORD=your-smtp-password

# Frontend URL (for CORS) - deprecated, use ALLOWED_ORIGINS
FRONTEND_URL=http://localhost:8080
USE_REAL_EMAIL=true

# Allowed Origins (comma-separated) - Add all your dashboard domains
ALLOWED_ORIGINS=https://auth.yourdomain.com,https://admin.yourdomain.com,https://officer.yourdomain.com,https://app.yourdomain.com

# IP Whitelisting (comma-separated, leave empty to allow all)
ADMIN_ALLOWED_IPS=127.0.0.1,::1,192.168.1.100
CERT_ALLOWED_IPS=127.0.0.1,::1,10.0.0.50

# Dashboard Redirect URLs (for authorization code flow)
ADMIN_DASHBOARD_URL=https://admin.yourdomain.com
CERT_DASHBOARD_URL=https://officer.yourdomain.com
PERSONNEL_DASHBOARD_URL=https://app.yourdomain.com
FAMILY_DASHBOARD_URL=https://app.yourdomain.com
VETERAN_DASHBOARD_URL=https://app.yourdomain.com
